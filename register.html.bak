<!DOCTYPE html>
<html lang="en">
 <head>
  <meta charset="UTF-8">
  <meta name="Generator" content="EditPlus®">
  <meta name="Author" content="">
  <meta name="Keywords" content="">
  <meta name="Description" content="">
  <title>Document</title>
 </head>
 <body>
  <center><h2>Registration</h2></center>
  <form method="post" action="login.html">
	<center><table>
  <tr>
	<td>Name</td>
	<td><input type="text" name="" required pattern="[A-za-z]+"></td>
  </tr>
  <tr>
	<td>Age</td>
	<td><input type="number" name="" min="18" max="60" required></td>
  </tr>
  <tr>
	<td>Email</td>
	<td><input type="email" name="" required></td>
  </tr>
  <tr>
	<td>Are you ready</td>
	<td><input type="radio" name="">yes <input type="radio" name="" required>no</td>
  </tr>
  <tr>
	<td>Photo</td>
	<td><input type="file" name="" accept="" ></td>
  </tr>
  <tr>
	<td>Resume</td>
	<td><input type="file" name="" accept="pdf" ></td>
  </tr>
  <tr>
	<td>password</td>
	<td><input type="password" name="" required></td>
  </tr>
  <tr>
	<td><a href="login.html"><input type="submit"></a></td>
	<td><input type="reset"></td>
  </tr>
  </table></center>
  </form>
 </body>
</html>
